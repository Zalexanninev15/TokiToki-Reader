# Copy to local.properties (git-ignored) or set as CI secrets.
# Never commit real values.

# Telegram — obtain your own pair at https://my.telegram.org ("API development tools").
# One phone number can hold exactly one api_id. The sample credentials shipped in
# open-source Telegram clients are rate-limited server side and will produce
# API_ID_PUBLISHED_FLOOD for your users.
telegram.apiId=0000000
telegram.apiHash=00000000000000000000000000000000

# Mastodon and Misskey need nothing here:
#   Mastodon registers this app dynamically via POST /api/v1/apps
#   Misskey uses MiAuth, which requires no prior app registration
